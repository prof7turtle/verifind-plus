# ------------------------------------------------------------------------------
# 1. HARDHAT / CONTRACTS ENVIRONMENT
# ------------------------------------------------------------------------------
HARDHAT_NETWORK=localhost
LOCAL_RPC_URL=http://127.0.0.1:8545
# Optional public testnet (e.g. Sepolia / Polygon Amoy)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
