ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ------------------------------------------------------------------------------
# 2. BACKEND API ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/sih26125_platform
RPC_URL=http://127.0.0.1:8545
IDENTITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ASSET_NFT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
JWT_SECRET=supersecret_jwt_key_sih26125
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. FRONTEND (VITE) ENVIRONMENT (Must start with VITE_)
